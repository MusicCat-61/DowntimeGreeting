<Window x:Class="DowntimeGreeting.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DowntimeGreeting"
        Width="600"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        KeyDown="OnWindowKeyDown">

    <Grid Margin="20">
        <Border x:Name="WindowBorder"
                CornerRadius="16"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Effect="{DynamicResource CardShadowEffect}">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="22">

                    <!-- Заголовок -->
                    <Grid x:Name="HeaderBar" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="46"
                                Height="46"
                                CornerRadius="13"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="DG"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="DowntimeGreeting"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="VersionText"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                VerticalAlignment="Top"
                                Click="OnCloseButtonClick" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,18,0,16" />

                    <!-- Описание -->
                    <TextBlock Text="{DynamicResource L_AboutDescription}"
                               Style="{StaticResource BodyTextStyle}"
                               LineHeight="24" />

                    <!-- Ссылки -->
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="{DynamicResource L_AboutProject}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="OnProjectLinkClick" />
                        <Button Content="{DynamicResource L_AboutTelegram}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,8"
                                Margin="0,0,8,8"
                                Click="OnTelegramLinkClick" />
                        <Button Content="{DynamicResource L_AboutDonate}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="14,8"
                                Margin="0,0,0,8"
                                Click="OnDonateLinkClick" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,16" />

                    <!-- Обновления -->
                    <TextBlock Text="{DynamicResource L_UpdTitle}"
                               Style="{StaticResource SectionTitleTextStyle}" />

                    <TextBlock x:Name="UpdateStatusText"
                               Text="{DynamicResource L_UpdIdle}"
                               Style="{StaticResource HintTextStyle}"
                               LineHeight="21"
                               Margin="0,2,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="CheckUpdateButton"
                                Content="{DynamicResource L_UpdCheck}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,8"
                                Click="OnCheckUpdateClick" />
                        <Button x:Name="OpenReleaseButton"
                                Content="{DynamicResource L_UpdOpenRelease}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,8"
                                Visibility="Collapsed"
                                Click="OnOpenReleaseClick" />
                    </WrapPanel>

                    <Button Content="{DynamicResource L_AboutClose}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="22,9"
                            Margin="0,12,0,0"
                            Click="OnCloseButtonClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>