<Window x:Class="DowntimeGreeting.GreetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DowntimeGreeting"
        Width="520"
        Height="308"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Opacity="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <!-- Отступ нужен, чтобы мягкая тень не обрезалась границами окна. -->
    <Grid x:Name="RootGrid" Margin="18" RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.95" ScaleY="0.95" />
        </Grid.RenderTransform>

        <Border x:Name="CardBorder"
                CornerRadius="16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Effect="{DynamicResource CardShadowEffect}">

            <Grid ClipToBounds="True">

                <!-- Блик «стекла» -->
                <Border CornerRadius="16"
                        Background="{DynamicResource GlassSheenBrush}"
                        IsHitTestVisible="False" />

                <!-- Акцентная полоса сверху -->
                <Border Height="3"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="16,16,0,0"
                        IsHitTestVisible="False" />

                <Grid Margin="30,26,30,18">
                    <Grid.RowDefinitions>
                        <!-- Шутливая фраза -->
                        <RowDefinition Height="Auto" />
                        <!-- Длительность простоя -->
                        <RowDefinition Height="*" />
                        <!-- Дата последнего выключения -->
                        <RowDefinition Height="Auto" />
                        <!-- Разделитель и обратный отсчёт -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PhraseText"
                               Grid.Row="0"
                               Style="{StaticResource GreetingPhraseTextStyle}"
                               MaxHeight="64" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DowntimeText"
                                   Style="{StaticResource GreetingDowntimeTextStyle}" />
                        <TextBlock x:Name="CaptionText"
                                   Text="{DynamicResource L_GreetingWasOff}"
                                   Style="{StaticResource GreetingCaptionTextStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="LastShutdownText"
                               Grid.Row="2"
                               Style="{StaticResource GreetingMetaTextStyle}" />

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <Border Height="1"
                                Background="{DynamicResource CardBorderBrush}"
                                Margin="0,0,0,9" />
                        <TextBlock x:Name="CountdownText"
                                   Style="{StaticResource GreetingCountdownTextStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>