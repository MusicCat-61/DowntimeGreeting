<Window x:Class="DowntimeGreeting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DowntimeGreeting.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DowntimeGreeting"
        Icon="app.ico"
        Width="660"
        Height="920"
        MinWidth="600"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Рамка окна: CaptionHeight=0 означает «нет системного заголовка», поэтому за
         заголовок тянет DragMove, а за края — ResizeBorderThickness. Слоистое окно
         (AllowsTransparency=True) изменить размер нельзя, поэтому фон непрозрачный. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">

        <Border x:Name="WindowBorder"
                CornerRadius="0"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок окна -->
                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      Height="58"
                      Margin="20,0,14,0"
                      Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="9"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="DG"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="DowntimeGreeting" Style="{StaticResource WindowTitleTextStyle}" />
                        <TextBlock Text="{DynamicResource L_AppSubtitle}"
                                   Style="{StaticResource WindowSubtitleTextStyle}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Переключатель языка интерфейса -->
                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="2"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource L_Language}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LangRuButton"
                                        Content="RU"
                                        Style="{StaticResource LangButtonStyle}"
                                        Click="OnLanguageRuClick" />
                                <Button x:Name="LangEnButton"
                                        Content="EN"
                                        Style="{StaticResource LangButtonStyle}"
                                        Click="OnLanguageEnClick" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="AboutButton"
                                Content="?"
                                Style="{StaticResource CloseButtonStyle}"
                                FontSize="15"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource L_About}"
                                Click="OnAboutButtonClick" />

                        <Button x:Name="CloseButton"
                                Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="{DynamicResource L_Close}"
                                Click="OnCloseButtonClick" />
                    </StackPanel>
                </Grid>

                <!-- Содержимое -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,4,20,20"
                              Focusable="False">

                    <StackPanel>

                        <!-- Автозагрузка -->
                        <TextBlock Text="{DynamicResource L_StartupSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Ellipse x:Name="StatusDot"
                                             Width="9"
                                             Height="9"
                                             Margin="0,0,9,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="StatusText"
                                               Text="{DynamicResource L_StartupChecking}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" />
                                </DockPanel>

                                <TextBlock x:Name="StatusHintText"
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="18,6,0,0"
                                           Text="{DynamicResource L_StartupHintDefault}" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="InstallButton"
                                            Content="{DynamicResource L_StartupAdd}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnInstallButtonClick" />
                                    <Button x:Name="UninstallButton"
                                            Content="{DynamicResource L_StartupRemove}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="10,0,0,0"
                                            Click="OnUninstallButtonClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Плашка -->
                        <TextBlock Text="{DynamicResource L_PlaqueSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource SectionCardStyle}">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="PreviewButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource L_ShowNow}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                        Click="OnPreviewButtonClick" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource L_PlaquePreviewTitle}" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="PreviewHintText"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Настройки -->
                        <TextBlock Text="{DynamicResource L_SettingsSection}" Style="{StaticResource SectionTitleTextStyle}" />
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource L_AutoCloseSeconds}"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                            MinWidth="52"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock x:Name="AutoCloseValueText"
                                                   Text="5"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   TextAlignment="Center" />
                                    </Border>
                                </Grid>

                                <Slider x:Name="AutoCloseSlider"
                                        Margin="0,6,0,0"
                                        Minimum="5"
                                        Maximum="15"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="1"
                                        LargeChange="1"
                                        Style="{StaticResource AppSliderStyle}"
                                        ValueChanged="OnAutoCloseSliderValueChanged" />

                                <Grid Margin="2,0,2,0">
                                    <TextBlock x:Name="MinSecondsText"
                                               Text="5"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource HintTextStyle}" />
                                    <TextBlock x:Name="MaxSecondsText"
                                               Text="15"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource HintTextStyle}" />
                                </Grid>

                                <TextBlock Text="{DynamicResource L_AccentColor}"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Margin="0,10,0,6" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <controls:ColorWheel x:Name="AccentWheel"
                                                         Grid.Column="0"
                                                         Width="112"
                                                         Height="112"
                                                         VerticalAlignment="Top"
                                                         SelectedColorChanged="OnAccentWheelColorChanged" />

                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="AccentTextBox"
                                                     Width="118"
                                                     MaxLength="9"
                                                     Style="{StaticResource CompactTextBoxStyle}" />
                                            <Border Width="36"
                                                    Height="36"
                                                    CornerRadius="9"
                                                    Margin="10,0,0,0"
                                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="AccentPreviewBrush" Color="#4D6BFE" />
                                                </Border.Background>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{DynamicResource L_Brightness}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   Margin="2,10,0,4" />
                                        <controls:ValueSlider x:Name="AccentValueSlider"
                                                              Height="24"
                                                              ValueChanged="OnAccentValueChanged" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource L_Phrases}"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Margin="0,14,0,6" />
                                <TextBox x:Name="PhrasesTextBox"
                                         Height="148"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         FontSize="16"
                                         Style="{StaticResource AppTextBoxStyle}" />

                                <StackPanel Margin="0,14,0,0">
                                    <Button x:Name="SaveButton"
                                            Content="{DynamicResource L_SaveSettings}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Click="OnSaveButtonClick" />

                                    <!-- Статус идёт отдельной строкой: сообщение об ошибке длиннее кнопки. -->
                                    <TextBlock x:Name="SaveStatusText"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Подвал -->
                        <Grid Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SettingsPathText"
                                       Grid.Column="0"
                                       Style="{StaticResource HintTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <Button x:Name="OpenLogsButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource L_OpenLogs}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,7"
                                    Margin="10,0,0,0"
                                    Click="OnOpenLogsButtonClick" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
